{
  "name": "five-kids-wear",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b && tsc -p worker --noEmit",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:schema": "wrangler d1 execute five-kids-wear --local --file=./worker/schema.sql",
    "db:schema:remote": "wrangler d1 execute five-kids-wear --remote --file=./worker/schema.sql",
    "db:migrate": "wrangler d1 execute five-kids-wear --local --file=./worker/migrations/001_bosta.sql",
    "db:migrate:remote": "wrangler d1 execute five-kids-wear --remote --file=./worker/migrations/001_bosta.sql",
    "db:migrate2": "wrangler d1 execute five-kids-wear --local --file=./worker/migrations/002_messages_and_login_guard.sql",
    "db:migrate2:remote": "wrangler d1 execute five-kids-wear --remote --file=./worker/migrations/002_messages_and_login_guard.sql"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
